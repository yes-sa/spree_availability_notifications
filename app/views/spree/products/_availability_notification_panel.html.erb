<% selected_variant ||= @selected_variant || @variant_from_options || default_product_variant(product) %>

<%
  selected_variant_options = selected_variant&.option_values&.includes(:option_type)&.each_with_object({}) do |option_value, hash|
    hash[option_value.option_type.name] = option_value.name
  end || {}
%>

<div class="availability-notification-section">
  <yes-sidepanel
    id="availability-notification-panel-<%= product.id %>"
    class="availability-notification-sidepanel"
    data-availability-notification-target="panel">

    <h3 slot="title"><%= Spree.t(:product_unavailable) %></h3>

    <div data-availability-notification-target="formContent">
      <yes-info-block>
        <%= Spree.t(:sign_up_notice) %>
      </yes-info-block>

      <form
        class="availability-notification-form"
        data-availability-notification-target="form"
        data-action="submit->availability-notification#submit">

        <input
          type="hidden"
          name="availability_notification[variant][sku]"
          value="<%= selected_variant&.sku || product.master&.sku %>"
          data-availability-notification-target="skuInput">

        <div data-availability-notification-target="optionsFields">
          <% selected_variant_options.each do |option_name, option_value| %>
            <input
              type="hidden"
              name="availability_notification[variant][options][<%= option_name %>]"
              value="<%= option_value %>">
          <% end %>
        </div>

        <div class="availability-notification-field">
          <label
            class="availability-notification-label"
            for="availability-notification-email-<%= product.id %>">
            <%= Spree.t('storefront.account_address.email_label') %>
          </label>

          <input
            id="availability-notification-email-<%= product.id %>"
            type="email"
            name="availability_notification[email]"
            class="input-text availability-notification-input"
            placeholder="<%= Spree.t('cart_checkout.delivery_address.email_placeholder') %>"
            autocomplete="email"
            required
            data-availability-notification-target="emailInput">
        </div>

        <div
          class="availability-notification-status"
          data-availability-notification-target="status"
          hidden>
        </div>

        <button
          type="submit"
          class="button availability-notification-submit yes-button"
          data-availability-notification-target="submitButton">
          <%= Spree.t(:notify_me) %>
        </button>
      </form>
    </div>

    <div
      class="availability-notification-success"
      data-availability-notification-target="successContent"
      hidden>
      <yes-info-block>
        <strong><%= Spree.t(:email_saved) %></strong>
        <br>
        <%= Spree.t(:request_retention_notice) %>
      </yes-info-block>

      <button
        type="button"
        class="button availability-notification-close yes-button"
        data-action="availability-notification#close">
        <%= Spree.t(:continue_shopping) %>
      </button>
    </div>
  </yes-sidepanel>
</div>
